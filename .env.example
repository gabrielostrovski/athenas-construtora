# Copie para .env e ajuste. Nunca publique o .env.
PORT=3000
HOST=0.0.0.0

# --- SUPABASE (Opcional - caso queira o banco na nuvem) ---
# Encontre no painel do Supabase: Project Settings > API
SUPABASE_URL=https://seu-projeto.supabase.co
# Use a anon_key (pública) ou service_role (secreta para backend)
SUPABASE_KEY=sua-chave-aqui

# --- SQLITE LOCAL (Usado automaticamente se o Supabase não estiver configurado) ---
DB_PATH=data/athenas.db

# Token para ver e gerenciar os pedidos em /api/admin/leads (mínimo 16 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Número com DDI+DDD (ex.: 554788090990). Se preenchido, o site oferece um botão de WhatsApp após o envio.
WHATSAPP_NUMBER=554788090990

# Use true somente atrás de proxy/HTTPS (Nginx, Caddy, Render, Railway etc.)
TRUST_PROXY=false

# Endereço público do site, se for diferente do host (ex.: https://athenasconstrutora.com.br)
SITE_ORIGIN=

# Opcional: URL https de webhook (Slack, Make, Zapier, Discord) para avisar cada novo pedido
NOTIFY_WEBHOOK_URL=
